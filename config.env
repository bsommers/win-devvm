# win-devvm configuration (sourced by the scripts; override via environment)
VM_NAME="${VM_NAME:-win-devvm}"
VM_RAM_MB="${VM_RAM_MB:-16384}"
VM_VCPUS="${VM_VCPUS:-8}"
VM_DISK_GB="${VM_DISK_GB:-120}"
LIBVIRT_URI="${LIBVIRT_URI:-qemu:///session}"   # rootless; no sudo needed
VM_DIR="${VM_DIR:-$HOME/vms/$VM_NAME}"
WIN_ISO="${WIN_ISO:-$HOME/Windows11_Client_x64_en-us_26300_9457.iso}"
VIRTIO_ISO="${VIRTIO_ISO:-$HOME/.cache/cvm/lab-images/virtio-win.iso}"
WIN_EDITION="${WIN_EDITION:-Windows 11 Pro}"   # must match an image NAME in install.wim
ADMIN_USER="${ADMIN_USER:-dev}"
ADMIN_PASS="${ADMIN_PASS:-devvm-Passw0rd!}"     # lab VM only; change after first login
SSH_PORT="${SSH_PORT:-2222}"                    # host:2222 -> guest:22 (OpenSSH)
RDP_PORT="${RDP_PORT:-3390}"                    # host:3390 -> guest:3389
SSH_KEY="${SSH_KEY:-$HOME/.ssh/id_windevvm}"       # generated by provision.sh if missing
