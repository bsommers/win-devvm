# shellcheck shell=bash
# win-devvm configuration (sourced by the scripts; override via environment)
# Backend: libvirt (Linux, rootless KVM) or parallels (macOS, Parallels Desktop on Apple Silicon).
# Guest OS: GUEST selects guests/<GUEST>/guest.env (default windows11).
# Generic names IMAGE_ISO / ARCH / IMAGE_EDITION; legacy WIN_ISO / WIN_ARCH / WIN_EDITION still honored.
HERE="${HERE:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
# shellcheck source=lib/common.sh
source "$HERE/lib/common.sh"
if [[ -z "${HYPERVISOR:-}" ]]; then
  case "$(uname -s)" in Darwin) HYPERVISOR=parallels ;; *) HYPERVISOR=libvirt ;; esac
fi
GUEST="${GUEST:-windows11}"
VM_NAME="${VM_NAME:-win-devvm}"
VM_DISK_GB="${VM_DISK_GB:-120}"
VM_DIR="${VM_DIR:-$HOME/vms/$VM_NAME}"          # state: generated media ISO, known_hosts
ADMIN_USER="${ADMIN_USER:-dev}"
ADMIN_PASS="${ADMIN_PASS:-devvm-Passw0rd!}"     # lab VM only; change after first login
SSH_KEY="${SSH_KEY:-$HOME/.ssh/id_windevvm}"       # generated by provision.sh if missing

if [[ ! -r "$HERE/guests/$GUEST/guest.env" ]]; then
  echo "unknown GUEST '$GUEST' (no guests/$GUEST/guest.env)" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$HERE/guests/$GUEST/guest.env"
IMAGE_EDITION="${IMAGE_EDITION:-${WIN_EDITION:-$IMAGE_EDITION_DEFAULT}}"

if [[ "$HYPERVISOR" == parallels ]]; then
  # Parallels Desktop Standard caps a VM at 4 vCPUs / 8 GB; Pro/Business may raise these.
  VM_RAM_MB="${VM_RAM_MB:-8192}"
  VM_VCPUS="${VM_VCPUS:-4}"
  ARCH="${ARCH:-${WIN_ARCH:-arm64}}"            # Apple Silicon guests are ARM64
  PRL_VM_HOME="${PRL_VM_HOME:-$HOME/Parallels}" # the .pvm bundle is created here
  PRL_APP="${PRL_APP:-/Applications/Parallels Desktop.app}"
  IMAGE_ISO="${IMAGE_ISO:-${WIN_ISO:-}}"
  if [[ -z "$IMAGE_ISO" ]]; then                # newest ARM64 ISO in the usual download spots
    # shellcheck disable=SC2086
    IMAGE_ISO="$(ls -t "$HOME"/Downloads/$IMAGE_GLOB_ARM64 "$HOME"/Library/Parallels/Downloads/$IMAGE_GLOB_ARM64 2>/dev/null | head -1 || true)"
  fi
else
  VM_RAM_MB="${VM_RAM_MB:-16384}"
  VM_VCPUS="${VM_VCPUS:-8}"
  ARCH="${ARCH:-${WIN_ARCH:-amd64}}"
  LIBVIRT_URI="${LIBVIRT_URI:-qemu:///session}" # rootless; no sudo needed
  IMAGE_ISO="${IMAGE_ISO:-${WIN_ISO:-$IMAGE_DEFAULT_AMD64}}"
  VIRTIO_ISO="${VIRTIO_ISO:-$HOME/.cache/cvm/lab-images/virtio-win.iso}"
  # Ports/MAC derive from VM_NAME so two VMs don't collide; the default name keeps 2222/3390/52:54:00:17:8c:66.
  VM_SLOT="$(vm_slot "$VM_NAME")"
  SSH_PORT="${SSH_PORT:-$((2222 + VM_SLOT))}"   # host:SSH_PORT -> guest:22 (OpenSSH)
  RDP_PORT="${RDP_PORT:-$((3390 + VM_SLOT))}"   # host:RDP_PORT -> guest:3389
  VM_MAC="${VM_MAC:-$(vm_mac "$VM_NAME")}"
fi
# Legacy aliases (read by older wrappers, e.g. bilterm's build-windows-vm.sh).
WIN_ISO="$IMAGE_ISO"; WIN_ARCH="$ARCH"; WIN_EDITION="$IMAGE_EDITION"
