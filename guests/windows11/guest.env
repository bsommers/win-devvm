# shellcheck shell=bash
# shellcheck disable=SC2034
# Guest definition: Windows 11. Sourced by config.env (after HYPERVISOR, VM_NAME, ADMIN_USER, HERE are set).
# Every value may be overridden from the environment.
GUEST_DIR="${GUEST_DIR:-$HERE/guests/windows11}"
GUEST_LABEL="Windows 11"
OS_VARIANT="${OS_VARIANT:-win11}"            # virt-install --osinfo
NEED_TPM="${NEED_TPM:-1}"                    # 1 = attach emulated TPM 2.0 (libvirt)
CONFIG_LABEL="${CONFIG_LABEL:-WINCONFIG}"    # volume label of the config ISO
BOOT_KEYS="${BOOT_KEYS:-KEY_SPACE}"          # tapped at boot to pass "Press any key to boot from CD"; empty = none
BOOT_KEYS_SECS="${BOOT_KEYS_SECS:-20}"
SSH_USER="${SSH_USER:-$ADMIN_USER}"
IMAGE_KIND=iso
IMAGE_EDITION_DEFAULT="Windows 11 Pro"       # must match an image NAME in install.wim
IMAGE_DEFAULT_AMD64="$HOME/Windows11_Client_x64_en-us_26300_9457.iso"
IMAGE_GLOB_ARM64='*A64FRE*.iso'              # newest match in ~/Downloads and ~/Library/Parallels/Downloads (parallels)
IMAGE_DESC_ARM64="Windows 11 ARM64 ISO"
GUEST_STOP_CMD='shutdown /s /t 0'            # run over SSH (parallels backend) for a clean stop
GUEST_BANNER="Windows installs unattended, reboots a few times, then runs setup-tools.ps1."
GUEST_PROGRESS_HINT='(done when C:\setup-tools.done exists)'
# Remote command (guest shell = PowerShell via OpenSSH); prints "tools: DONE" / "tools: FAILED ..." / "tools: installing ...".
GUEST_READY_CMD='if (Test-Path C:\setup-tools.done) {"tools: DONE"} elseif (Test-Path C:\setup-tools.failed) {"tools: FAILED " + (Get-Content C:\setup-tools.failed)} else {"tools: installing (see C:\setup-tools.log)"}'

# guest_stage <stage-dir>: render the unattended-install payload into the staged config dir.
guest_stage() {
  local stage="$1" tg_reboot=Never computer
  # Parallels: reboot after the toolgate driver install in specialize (mirrors Parallels' own answer file).
  [[ "$HYPERVISOR" == parallels ]] && tg_reboot=Always
  computer="$(printf '%s' "$VM_NAME" | tr 'a-z' 'A-Z' | cut -c1-15)"
  sed -e "s|@@EDITION@@|$(esc "$IMAGE_EDITION")|" -e "s|@@VMNAME@@|$(esc "$computer")|" \
      -e "s|@@USER@@|$(esc "$ADMIN_USER")|g" -e "s|@@PASS@@|$(esc "$ADMIN_PASS")|g" \
      -e "s|@@ARCH@@|$ARCH|g" -e "s|@@TG_REBOOT@@|$tg_reboot|g" \
      "$GUEST_DIR/autounattend.xml.tmpl" > "$stage/autounattend.xml"
  cp "$GUEST_DIR/setup-tools.ps1" "$stage/"
}
