# shellcheck shell=bash
# shellcheck disable=SC2034
# Guest definition: Ubuntu 24.04 LTS (noble) x86_64 cloud image. Sourced by config.env.
# Boots the vendor cloud image; cloud-init (NoCloud seed ISO) creates $ADMIN_USER with the host SSH key.
GUEST_DIR="${GUEST_DIR:-$HERE/guests/ubuntu}"
GUEST_LABEL="Ubuntu 24.04"
IMAGE_KIND=cloudimg
OS_VARIANT="${OS_VARIANT:-ubuntu24.04}"      # virt-install --osinfo
NEED_TPM=0
BOOT_KEYS=""
BOOT_KEYS_SECS=0
CONFIG_LABEL=cidata
GUEST_DISK_GB=20
SSH_USER="${SSH_USER:-$ADMIN_USER}"          # created by cloud-init; keys only, no password
IMAGE_URL="${IMAGE_URL:-https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img}"
IMAGE_FILE="${IMAGE_FILE:-noble-server-cloudimg-amd64.img}"
IMAGE_SUMS="${IMAGE_SUMS:-https://cloud-images.ubuntu.com/noble/current/SHA256SUMS}"   # or sha256:<hex>
GUEST_STOP_CMD='sudo shutdown -h now'
GUEST_BANNER="Ubuntu boots the cloud image; cloud-init adds user $SSH_USER and installs base dev tools."
GUEST_PROGRESS_HINT='(done when /var/lib/devvm-ready exists)'
GUEST_READY_CMD='test -e /var/lib/devvm-ready && echo "tools: DONE" || echo "tools: installing (cloud-init)"'

# guest_stage <stage-dir>: write cloud-init user-data + meta-data (needs $SSH_KEY.pub to exist).
guest_stage() {
  local stage="$1"
  # shellcheck source=/dev/null
  source "$HERE/lib/cloudinit.sh"
  printf '%s\n' \
    'DEBIAN_FRONTEND=noninteractive apt-get update' \
    'DEBIAN_FRONTEND=noninteractive apt-get install -y git build-essential curl' \
    > "$stage/runcmd.txt"
  ci_write_user_data "$stage" "$SSH_USER" "$SSH_KEY.pub" "$stage/runcmd.txt"
  ci_write_meta_data "$stage" "$VM_NAME" "$VM_NAME"
}
