# shellcheck shell=bash
# shellcheck disable=SC2034
# Guest definition: FreeBSD amd64 BASIC-CLOUDINIT (UFS) VM image. Sourced by config.env.
# Official image (download.freebsd.org/releases/VM-IMAGES); first boot runs nuageinit, which reads the
# NoCloud "cidata" seed ISO: creates $ADMIN_USER with the host SSH key (keys only) and runs the tool setup.
GUEST_DIR="${GUEST_DIR:-$HERE/guests/freebsd}"
GUEST_LABEL="FreeBSD"
FREEBSD_REL="${FREEBSD_REL:-15.1}"
IMAGE_KIND=cloudimg
OS_VARIANT="${OS_VARIANT:-freebsd14.0}"      # osinfo lags; any valid freebsd entry works (check: osinfo-query os | grep freebsd)
MACHINE=q35                                  # osinfo picks i440fx for FreeBSD; the NIC is placed on pcie.0
UEFI_BOOT="uefi,firmware.feature0.name=secure-boot,firmware.feature0.enabled=no,firmware.feature1.name=enrolled-keys,firmware.feature1.enabled=no"   # FreeBSD loader.efi is not Secure Boot signed
NEED_TPM=0
BOOT_KEYS=""
BOOT_KEYS_SECS=0
CONFIG_LABEL=cidata
GUEST_DISK_GB=40                             # rust + qemu are large; growfs expands the UFS root on first boot
SSH_USER="${SSH_USER:-$ADMIN_USER}"
_fbsd_dir="https://download.freebsd.org/releases/VM-IMAGES/$FREEBSD_REL-RELEASE/amd64/Latest"
IMAGE_FILE="${IMAGE_FILE:-FreeBSD-$FREEBSD_REL-RELEASE-amd64-BASIC-CLOUDINIT-ufs.qcow2.xz}"   # .xz: verified, then decompressed
IMAGE_URL="${IMAGE_URL:-$_fbsd_dir/$IMAGE_FILE}"
IMAGE_SUMS="${IMAGE_SUMS:-$_fbsd_dir/CHECKSUM.SHA256}"   # or sha256:<hex>
GUEST_STOP_CMD='sudo shutdown -p now'
GUEST_BANNER="FreeBSD boots the official cloud image; nuageinit adds user $SSH_USER and pkg-installs git, rust, qemu."
GUEST_PROGRESS_HINT='(done when /var/db/devvm-ready exists)'
GUEST_READY_CMD='if test -e /var/db/devvm-ready; then echo "tools: DONE"; elif test -e /var/db/devvm-failed; then echo "tools: FAILED (see /var/log/devvm-setup.log)"; else echo "tools: installing (nuageinit)"; fi'

# guest_stage <stage-dir>: write NoCloud user-data + meta-data (needs $SSH_KEY.pub to exist).
guest_stage() {
  local stage="$1"
  # shellcheck source=/dev/null
  source "$HERE/lib/cloudinit.sh"
  cp "$GUEST_DIR/setup-tools.sh" "$stage/setup-tools.sh"
  # Base FreeBSD has no bash/sudo: use /bin/sh and let setup-tools.sh install sudo (+ sudoers drop-in).
  # nuageinit runs runcmd in the foreground BEFORE sshd starts, and the image's first-boot pkgbase update requests a
  # reboot that kills background jobs. So runcmd only drops the script (base64: one YAML-safe line) plus an
  # /etc/rc.local that (re)starts it detached at every boot until a ready/failed marker exists, then starts it now.
  printf '%s\n' \
    "echo $(base64 < "$stage/setup-tools.sh" | tr -d '\n') | b64decode -r > /root/setup-tools.sh" \
    "echo '[ -e /var/db/devvm-ready ] || [ -e /var/db/devvm-failed ] || (nohup sh /root/setup-tools.sh $SSH_USER </dev/null >/dev/null 2>&1 &)' > /etc/rc.local" \
    "sh /etc/rc.local" \
    > "$stage/runcmd.txt"
  CI_USER_SHELL=/bin/sh CI_USER_SUDO="" CI_READY_ALWAYS=0 \
    ci_write_user_data "$stage" "$SSH_USER" "$SSH_KEY.pub" "$stage/runcmd.txt"
  ci_write_meta_data "$stage" "$VM_NAME" "$VM_NAME"
}
