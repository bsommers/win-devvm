# shellcheck shell=bash
# shellcheck disable=SC2034
# Guest definition: Fedora 45 Cloud Base (Generic) x86_64 qcow2. Sourced by config.env.
# Boots the vendor cloud image; cloud-init (NoCloud seed ISO) creates $ADMIN_USER with the host SSH key.
GUEST_DIR="${GUEST_DIR:-$HERE/guests/fedora}"
GUEST_LABEL="Fedora 45"
FEDORA_REL="${FEDORA_REL:-45}"
FEDORA_BUILD="${FEDORA_BUILD:-1.4}"          # compose id; bump with FEDORA_REL
IMAGE_KIND=cloudimg
OS_VARIANT="${OS_VARIANT:-fedora-unknown}"   # libosinfo lags new releases; fedora-unknown is always valid
NEED_TPM=0
BOOT_KEYS=""
BOOT_KEYS_SECS=0
CONFIG_LABEL=cidata
GUEST_DISK_GB=20
SSH_USER="${SSH_USER:-$ADMIN_USER}"          # created by cloud-init; keys only, no password
_fedora_dir="https://dl.fedoraproject.org/pub/fedora/linux/releases/$FEDORA_REL/Cloud/x86_64/images"
IMAGE_FILE="${IMAGE_FILE:-Fedora-Cloud-Base-Generic-$FEDORA_REL-$FEDORA_BUILD.x86_64.qcow2}"
IMAGE_URL="${IMAGE_URL:-$_fedora_dir/$IMAGE_FILE}"
IMAGE_SUMS="${IMAGE_SUMS:-$_fedora_dir/Fedora-Cloud-$FEDORA_REL-$FEDORA_BUILD-x86_64-CHECKSUM}"   # or sha256:<hex>
GUEST_STOP_CMD='sudo shutdown -h now'
GUEST_BANNER="Fedora boots the cloud image; cloud-init adds user $SSH_USER and installs base dev tools."
GUEST_PROGRESS_HINT='(done when /var/lib/devvm-ready exists)'
GUEST_READY_CMD='test -e /var/lib/devvm-ready && echo "tools: DONE" || echo "tools: installing (cloud-init)"'

# guest_stage <stage-dir>: write cloud-init user-data + meta-data (needs $SSH_KEY.pub to exist).
guest_stage() {
  local stage="$1"
  # shellcheck source=/dev/null
  source "$HERE/lib/cloudinit.sh"
  printf '%s\n' \
    'dnf install -y git gcc gcc-c++ make curl' \
    > "$stage/runcmd.txt"
  ci_write_user_data "$stage" "$SSH_USER" "$SSH_KEY.pub" "$stage/runcmd.txt"
  ci_write_meta_data "$stage" "$VM_NAME" "$VM_NAME"
}
