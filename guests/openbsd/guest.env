# shellcheck shell=bash
# shellcheck disable=SC2034
# Guest definition: OpenBSD amd64, built locally by guests/openbsd/build-image.sh (no official cloud image).
# The script drives the official installer over serial (signify + SHA256 verified), bakes user $SSH_USER + the host
# SSH key + pkg set into a qcow2 in the image cache, and writes <image>.sha256 next to it. Run it once before provision.sh.
GUEST_DIR="${GUEST_DIR:-$HERE/guests/openbsd}"
GUEST_LABEL="OpenBSD"
OPENBSD_REL="${OPENBSD_REL:-8.0}"
IMAGE_KIND=cloudimg
OS_VARIANT="${OS_VARIANT:-openbsd7.6}"       # osinfo lags; any valid openbsd entry works (osinfo-query os | grep openbsd)
MACHINE=q35                                  # the NIC is placed on pcie.0 (see lib/libvirt.sh)
UEFI_BOOT=hd                                 # image is MBR/BIOS-booted (SeaBIOS), not UEFI
NEED_TPM=0
BOOT_KEYS=""
BOOT_KEYS_SECS=0
CONFIG_LABEL=cidata                          # seed ISO is attached but ignored: OpenBSD has no cloud-init
GUEST_DISK_GB=40                             # overlay size; sd0 was installed at 40G (build-image.sh GUEST_DISK_GB)
SSH_USER="${SSH_USER:-bill}"                 # baked into the image by build-image.sh (BUILD_USER)
_ob_cache="${IMAGE_CACHE:-$HOME/.cache/win-devvm/images}"
IMAGE_FILE="${IMAGE_FILE:-openbsd-$OPENBSD_REL-amd64.qcow2}"
IMAGE_URL="${IMAGE_URL:-file://$_ob_cache/$IMAGE_FILE}"
IMAGE_SUMS="${IMAGE_SUMS:-file://$_ob_cache/$IMAGE_FILE.sha256}"
GUEST_STOP_CMD='doas halt -p'
GUEST_BANNER="OpenBSD boots the locally built image (guests/openbsd/build-image.sh); user $SSH_USER, key-only ssh, doas, pkg git/rust/qemu baked in."
GUEST_PROGRESS_HINT='(ready as soon as ssh answers)'
GUEST_READY_CMD='echo "tools: DONE"'

# guest_stage <stage-dir>: nothing to render (no cloud-init); just require the pre-built image.
guest_stage() {
  local stage="$1"
  if [[ "$IMAGE_URL" == file://* && ! -r "${IMAGE_URL#file://}" ]]; then
    echo "OpenBSD image missing: ${IMAGE_URL#file://}. Build it first: $GUEST_DIR/build-image.sh" >&2
    exit 1
  fi
  printf 'instance-id: %s\nlocal-hostname: %s\n' "$VM_NAME" "$VM_NAME" > "$stage/meta-data"
  : > "$stage/user-data"
}
